# ==========================================================================
#  Mars Sign & Craft — generated by build.js. Do not hand-edit.
# ==========================================================================

Options -MultiViews
DirectoryIndex index.html index.php

RewriteEngine On
RewriteBase /

# --------------------------------------------------------------------------
# 1. CANONICAL HOST — force https + non-www (pick ONE, this is non-www)
# --------------------------------------------------------------------------
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# --------------------------------------------------------------------------
# 1b. DUPLICATE-URL CONSOLIDATION
#     Fixes Search Console "Duplicate without user-selected canonical" and
#     "Alternative page with proper canonical tag".
# --------------------------------------------------------------------------
# /index.html -> /            (a classic duplicate of the homepage)
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Strip tracking / session params that spawn duplicate URLs
RewriteCond %{QUERY_STRING} (^|&)(utm_[a-z]+|fbclid|gclid|msclkid|ref)= [NC]
RewriteRule ^(.*)$ /$1? [R=301,L]

# --------------------------------------------------------------------------
# 2. LEGACY BLOG POSTS  blog.html?post=slug  ->  /blog/new-slug/
# --------------------------------------------------------------------------
RewriteCond %{QUERY_STRING} (^|&)post=Custom-Vouchers-Tickets-Doha(&|$) [NC]
RewriteRule ^blog\.html$ /blog/custom-vouchers-tickets-doha/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)post=Corporate-Event-Stationery-Doha(&|$) [NC]
RewriteRule ^blog\.html$ /blog/corporate-event-stationery-doha/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)post=Custom-Paper-Cups-Sleeves-Doha(&|$) [NC]
RewriteRule ^blog\.html$ /blog/custom-paper-cups-sleeves-doha/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)post=Branded-Gift-Boxes-Packaging-Doha(&|$) [NC]
RewriteRule ^blog\.html$ /blog/branded-gift-boxes-packaging-doha/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)post=Promotional-Brochures-Flyers-Doha(&|$) [NC]
RewriteRule ^blog\.html$ /blog/promotional-brochures-flyers-doha/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)post=Custom-Certificates-Doha(&|$) [NC]
RewriteRule ^blog\.html$ /blog/custom-certificates-doha/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)post=Custom-Corporate-Envelopes-Doha(&|$) [NC]
RewriteRule ^blog\.html$ /blog/custom-corporate-envelopes-doha/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)post=The-Future-of-Commercial-Architecture-and-Signage-Solutions-in-Qatar(&|$) [NC]
RewriteRule ^blog\.html$ /blog/future-of-commercial-spaces-qatar/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)post=Why(?:\s|%20|\+)+Professional(?:\s|%20|\+)+Printing(?:\s|%20|\+)+Still(?:\s|%20|\+)+Matters(?:\s|%20|\+)+in(?:\s|%20|\+)+the(?:\s|%20|\+)+Digital(?:\s|%20|\+)+Age(&|$) [NC]
RewriteRule ^blog\.html$ /blog/why-professional-printing-still-matters/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)post=minimalist-architecture(&|$) [NC]
RewriteRule ^blog\.html$ /blog/minimalist-architecture/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)post=digital-urbanism(&|$) [NC]
RewriteRule ^blog\.html$ /blog/digital-urbanism-smart-cities/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)post=industrial-craftsmanship(&|$) [NC]
RewriteRule ^blog\.html$ /blog/industrial-craftsmanship/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)post=urban-wayfinding(&|$) [NC]
RewriteRule ^blog\.html$ /blog/urban-wayfinding/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)post=luxury-retail-spaces(&|$) [NC]
RewriteRule ^blog\.html$ /blog/luxury-retail-spaces/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)post=everything-about-laser-engraving-qatar(&|$) [NC]
RewriteRule ^blog\.html$ /blog/everything-about-laser-engraving-qatar/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)post=sustainable-cities(&|$) [NC]
RewriteRule ^blog\.html$ /blog/sustainable-printing-smart-fabrication/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)post=types-of-signage(&|$) [NC]
RewriteRule ^blog\.html$ /blog/types-of-signage/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)post=complete-guide-promotional-products-qatar(&|$) [NC]
RewriteRule ^blog\.html$ /blog/complete-guide-promotional-products-qatar/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)post=vehicle-branding-local-businesses(&|$) [NC]
RewriteRule ^blog\.html$ /blog/vehicle-branding-local-businesses/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)post=(?:\s|%20|\+)*Reception-Desk-Doha(&|$) [NC]
RewriteRule ^blog\.html$ /blog/reception-counter-fabrication-doha/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)post=acrylic-vs-metal-signs(&|$) [NC]
RewriteRule ^blog\.html$ /blog/acrylic-vs-metal-signs/? [R=301,L]

# Bare blog.html (and any unmatched ?post=) -> /blog/
RewriteRule ^blog\.html$ /blog/? [R=301,L]

# --------------------------------------------------------------------------
# 3. LEGACY SERVICES  services.html?service=key  ->  /services/new-slug/
#    NOTE: ?service=fleet and ?service=interior were indexed by Google but
#    never existed in app.js (they silently rendered the signage page).
#    They now resolve to the correct dedicated pages.
# --------------------------------------------------------------------------
RewriteCond %{QUERY_STRING} (^|&)service=signage(&|$) [NC]
RewriteRule ^services\.html$ /services/signage/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)service=printing(&|$) [NC]
RewriteRule ^services\.html$ /services/professional-printing/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)service=engraving(&|$) [NC]
RewriteRule ^services\.html$ /services/laser-engraving/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)service=fleet(&|$) [NC]
RewriteRule ^services\.html$ /services/fleet-branding/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)service=vehicle(&|$) [NC]
RewriteRule ^services\.html$ /services/fleet-branding/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)service=interior(&|$) [NC]
RewriteRule ^services\.html$ /services/interior-decor/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)service=decor(&|$) [NC]
RewriteRule ^services\.html$ /services/interior-decor/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)service=awards(&|$) [NC]
RewriteRule ^services\.html$ /services/awards-trophies/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)service=embroidery(&|$) [NC]
RewriteRule ^services\.html$ /services/embroidery/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)service=promotional(&|$) [NC]
RewriteRule ^services\.html$ /services/promotional-products/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)service=promo1(&|$) [NC]
RewriteRule ^services\.html$ /services/promotional-products/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)service=promo2(&|$) [NC]
RewriteRule ^services\.html$ /services/promotional-products/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)service=traffic(&|$) [NC]
RewriteRule ^services\.html$ /services/road-traffic-signage/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)service=road(&|$) [NC]
RewriteRule ^services\.html$ /services/road-traffic-signage/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)service=cladding(&|$) [NC]
RewriteRule ^services\.html$ /services/cladding-facade-fabrication/? [R=301,L]
RewriteCond %{QUERY_STRING} (^|&)service=facade(&|$) [NC]
RewriteRule ^services\.html$ /services/cladding-facade-fabrication/? [R=301,L]

# Bare services.html (and any unmatched ?service=) -> /services/
RewriteRule ^services\.html$ /services/? [R=301,L]

# --------------------------------------------------------------------------
# 4. LEGACY PROJECT + MISC PAGES
# --------------------------------------------------------------------------
RedirectMatch 301 ^/project-exhibition\.html$ /projects/exhibition-graphics/
RedirectMatch 301 ^/project-facades\.html$ /projects/architectural-shop-facades/
RedirectMatch 301 ^/project-engraving\.html$ /projects/precision-engraving/
# --- Legacy CMS URLs from the pre-2018 site. Google still surfaces some of
# --- these (e.g. /Our-Services) and they currently return 404, which wastes
# --- the equity they still hold. Case-insensitive because the old CMS mixed case.
RedirectMatch 301 (?i)^/our-services/?$      /services/
RedirectMatch 301 (?i)^/our-service/?$       /services/
RedirectMatch 301 (?i)^/services-2/?$        /services/
RedirectMatch 301 (?i)^/about-us/?$          /about/
RedirectMatch 301 (?i)^/aboutus/?$           /about/
RedirectMatch 301 (?i)^/contact-us/?$        /#contact
RedirectMatch 301 (?i)^/contactus/?$         /#contact
RedirectMatch 301 (?i)^/home/?$              /
RedirectMatch 301 (?i)^/gallery/?$           /projects/
RedirectMatch 301 (?i)^/products/?$          /services/
RedirectMatch 301 (?i)^/our-products/?$      /services/
RedirectMatch 301 (?i)^/portfolio/?$         /projects/
RedirectMatch 301 (?i)^/road-signage/?$      /services/road-traffic-signage/
RedirectMatch 301 (?i)^/traffic-signage/?$   /services/road-traffic-signage/
RedirectMatch 301 (?i)^/cladding/?$          /services/cladding-facade-fabrication/
RedirectMatch 301 (?i)^/awnings/?$           /services/steel-structures-awnings/

RedirectMatch 301 ^/projects\.html$ /projects/
RedirectMatch 301 ^/portfolio-item\.html$ /projects/
RedirectMatch 301 ^/blog-seo-qatar\.html$ /blog/
RedirectMatch 301 ^/divisions-core\.html$ /projects/

# --------------------------------------------------------------------------
# 5. TRAILING SLASH — /blog/foo -> /blog/foo/  (one canonical form)
# --------------------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [R=301,L]

# --------------------------------------------------------------------------
# 6. COMPRESSION
# --------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
  AddOutputFilterByType DEFLATE image/svg+xml image/x-icon
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2 application/vnd.ms-fontobject
</IfModule>

# --------------------------------------------------------------------------
# 7. CACHING — hashed/derivative assets get a year, HTML stays fresh
# --------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                        "access plus 1 month"
  ExpiresByType text/html               "access plus 0 seconds"
  ExpiresByType text/css                "access plus 1 year"
  ExpiresByType application/javascript  "access plus 1 year"
  ExpiresByType image/avif              "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType font/woff2              "access plus 1 year"
  ExpiresByType application/xml         "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(avif|webp|jpe?g|png|gif|svg|woff2?|css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# --------------------------------------------------------------------------
# 8. MIME TYPES
# --------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType image/avif  .avif
  AddType image/webp  .webp
  AddType font/woff2  .woff2
</IfModule>

# --------------------------------------------------------------------------
# 9. PHP HANDLER (cPanel — leave as-is)
# --------------------------------------------------------------------------
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php80 .php .php8 .phtml
</IfModule>

ErrorDocument 404 /404.html
